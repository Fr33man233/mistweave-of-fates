{
  "name": "mistweave-of-fates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:model": "vitest run src/model server/model",
    "model:t1": "node scripts/model-preflight.mjs --live",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:production-boundary": "node scripts/check-production-test-boundary.mjs",
    "test:automation": "pnpm run loop:fast && pnpm run test:e2e",
    "loop:fast": "pnpm run test && pnpm run build && pnpm run test:production-boundary",
    "loop:full": "pnpm run test:automation",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
